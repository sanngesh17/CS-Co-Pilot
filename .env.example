# Copy to .env and fill in what you have. Anything missing is skipped (the app falls back to sample data / rules).

# --- You
CSM_NAME=Sanngesh
COMPANY_DOMAINS=cardamon.ai

# --- OpenAI (scores and sorts your messages)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna

# --- Slack (DMs + group DMs). User OAuth Token from the app created with slack_app_manifest.yaml
SLACK_USER_TOKEN=
# Channels to skip (comma-separated, without #)
SLACK_EXCLUDE_CHANNELS=social,random

# --- Gmail. OAuth client JSON (Desktop app) from Google Cloud Console
GOOGLE_CLIENT_SECRET_FILE=.secrets/google_client_secret.json

# --- Fixture CRM (optional; until then data/fixture_accounts.json is used)
FIXTURE_API_KEY=
FIXTURE_ACCOUNTS_URL=
